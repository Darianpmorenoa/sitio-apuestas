{
  "name": "apuestas-backend",
  "version": "1.0.0",
  "description": "Backend para sitio de apuestas de fútbol chileno",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "liquidar": "node scripts/liquidar.js",
    "admin": "node scripts/admin.js",
    "pruebas:crear": "node scripts/base-pruebas.js crear",
    "pruebas:reiniciar": "node scripts/base-pruebas.js reiniciar",
    "dev:pruebas": "nodemon --exec \"node --env-file=.env.test\" server.js",
    "liquidar:pruebas": "node --env-file=.env.test scripts/liquidar.js",
    "admin:pruebas": "node --env-file=.env.test scripts/admin.js",
    "clave": "node scripts/clave.js",
    "clave:pruebas": "node --env-file=.env.test scripts/clave.js"
  },
  "keywords": ["apuestas", "futbol", "chile"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
